

<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>District Map - Shahdol</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #fff;
    color: #222;
}

.map-section {
    width: 100%;
    padding: 45px 5%;
    background: white;
}

.map-container {
    max-width: 1300px;
    margin: auto;
}

.map-title {
    color: #5d3c00;
    font-size: 32px;
    margin-bottom: 12px;
    border-left: 6px solid #dfa936;
    padding-left: 15px;
}

.map-description {
    font-size: 16px;
    color: #555;
    margin-bottom: 25px;
    line-height: 1.7;
}

.map-box {
    width: 100%;
    height: 550px;
    border: 1px solid #ddd;
    box-shadow: 0 3px 15px rgba(0,0,0,0.12);
    overflow: hidden;
    border-radius: 5px;
}

.map-box iframe {
    width: 100%;
    height: 100%;
    border: 0;
}

.map-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 22px;
}

.map-buttons a {
    background: #805900;
    color: white;
    padding: 13px 22px;
    border-radius: 5px;
    text-decoration: none;
    font-size: 15px;
    transition: 0.3s;
}

.map-buttons a:hover {
    background: #dfa936;
    color: #222;
}

.map-footer {
    margin-top: 30px;
    background: #fff0d2;
    padding: 20px;
    border-left: 5px solid #dfa936;
    line-height: 1.8;
}

.bottom-strip {
    height: 75px;
    background: #dfa936;
    margin-top: 35px;
}

@media(max-width:600px) {
    .map-section {
        padding: 30px 15px;
    }

    .map-title {
        font-size: 25px;
    }

    .map-box {
        height: 400px;
    }

    .map-buttons {
        flex-direction: column;
    }

    .map-buttons a {
        text-align: center;
    }
}
</style>
</head>

<body>

<section class="map-section">

<div class="map-container">

    <h1 class="map-title">
        जिले का मानचित्र
    </h1>

    <p class="map-description">
        जिला शहडोल, मध्य प्रदेश का भौगोलिक मानचित्र।
        यहाँ आप शहडोल जिले और आसपास के क्षेत्रों को देख सकते हैं।
    </p>

    <!-- GOOGLE DISTRICT MAP -->

    <div class="map-box">

        <iframe
            src="https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1sdistrict+shahdol!6i9"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>

    </div>

    <!-- MAP BUTTONS -->

    <div class="map-buttons">

        <a href="https://www.google.com/maps/search/?api=1&query=Shahdol+District+Madhya+Pradesh"
           target="_blank">
            Open in Google Maps ↗
        </a>

        <a href="https://shahdol.nic.in/en/map-of-district/"
           target="_blank">
            Official District Map ↗
        </a>

    </div>

    <!-- INFORMATION -->

    <div class="map-footer">

        <h3>District Shahdol</h3>

        <p>
            State: Madhya Pradesh
        </p>

        <p>
            District Headquarters: Shahdol
        </p>

        <p>
            Area: 5,610 Sq. Km.
        </p>

    </div>

</div>

</section>

<div class="bottom-strip"></div>

</body>
</html>
