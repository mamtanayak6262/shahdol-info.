<title>District Map - Shahdol | Madhya Pradesh</title>

<style>

/* BASIC CSS */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #ffffff;
    color: #222;
}

/* HEADER */

header {
    background: #fff;
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ddd;
    flex-wrap: wrap;
    gap: 15px;
}

.logo h2 {
    color: #684500;
    font-size: 25px;
}

.logo p {
    margin-top: 5px;
    font-size: 14px;
}

.home-btn {
    background: #805900;
    color: white;
    padding: 12px 22px;
    text-decoration: none;
    border-radius: 5px;
}

.home-btn:hover {
    background: #dfa936;
    color: #222;
}

/* NAVIGATION */

nav {
    background: white;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
    padding: 0 5%;
}

nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
}

nav ul li a {
    display: block;
    padding: 16px 18px;
    color: #222;
    text-decoration: none;
    font-size: 15px;
}

nav ul li a:hover,
nav ul li.active a {
    background: #805900;
    color: white;
}

/* MAP SECTION */

.map-section {
    width: 100%;
    padding: 45px 5%;
    background: white;
}

.map-container {
    max-width: 1300px;
    margin: auto;
}

.map-title {
    color: #5d3c00;
    font-size: 32px;
    margin-bottom: 12px;
    border-left: 6px solid #dfa936;
    padding-left: 15px;
}

.map-description {
    font-size: 16px;
    color: #555;
    margin-bottom: 25px;
    line-height: 1.7;
}

/* GOOGLE MAP */

.map-box {
    width: 100%;
    height: 550px;
    border: 1px solid #ddd;
    box-shadow: 0 3px 15px rgba(0,0,0,0.12);
    overflow: hidden;
    border-radius: 5px;
}

.map-box iframe {
    width: 100%;
    height: 100%;
    border: 0;
}

/* MAP BUTTONS */

.map-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 22px;
}

.map-buttons a {
    background: #805900;
    color: white;
    padding: 13px 22px;
    border-radius: 5px;
    text-decoration: none;
    font-size: 15px;
    transition: 0.3s;
}

.map-buttons a:hover {
    background: #dfa936;
    color: #222;
}

/* DISTRICT INFORMATION */

.map-footer {
    margin-top: 30px;
    background: #fff0d2;
    padding: 25px;
    border-left: 5px solid #dfa936;
    line-height: 2;
    border-radius: 5px;
}

.map-footer h3 {
    color: #684500;
    margin-bottom: 10px;
    font-size: 22px;
}

/* FOOTER */

footer {
    background: #4f3500;
    color: white;
    padding: 30px 5%;
    text-align: center;
    margin-top: 35px;
}

footer h3 {
    color: #eab12c;
    margin-bottom: 12px;
}

footer p {
    font-size: 14px;
    line-height: 1.8;
}

/* BOTTOM STRIP */

.bottom-strip {
    height: 12px;
    background: #dfa936;
    width: 100%;
}

/* RESPONSIVE DESIGN */

@media(max-width:600px) {

    header {
        flex-direction: column;
        align-items: flex-start;
    }

    nav ul {
        flex-direction: column;
    }

    .map-section {
        padding: 30px 15px;
    }

    .map-title {
        font-size: 25px;
    }

    .map-box {
        height: 400px;
    }

    .map-buttons {
        flex-direction: column;
    }

    .map-buttons a {
        text-align: center;
    }

}

</style>

</head>

